# PostgreSQL（Docker Compose）
POSTGRES_DB=offenro
POSTGRES_USER=offenro
POSTGRES_PASSWORD=offenro
POSTGRES_PORT=5432

# PostgreSQL接続先（Go Server／goose／統合テスト用）
DATABASE_URL=postgres://offenro:offenro@localhost:5432/offenro?sslmode=disable

# pgweb
PGWEB_PORT=8081

# Offenro Management API
MANAGEMENT_API_TOKEN=local-management-token

# Offenro Offer ID署名・暗号化
OFFER_TOKEN_SECRET=replace-this-with-at-least-32-characters

# Stripe（将来のPayment／Webhook実装用）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
